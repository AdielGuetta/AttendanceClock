{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "AttendanceClock",
    "Audience": "AttendanceClock",
    "TokenLifetime": "01:00:00",
